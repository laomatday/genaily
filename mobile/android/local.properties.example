# Copy to local.properties only to configure your local Android SDK.
# Public production endpoint/key are already in config/production.properties.
# Do not copy placeholder endpoint/key values into local.properties.
sdk.dir=/absolute/path/to/Android/Sdk

# Optional override for a rotated publishable key (never use service_role):
# GENAI_PUBLISHABLE_KEY=your_new_publishable_key
