{
  "name": "genai-family",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/components src/hooks src/lib",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:e2e": "node scripts/seed-e2e.mjs",
    "seed:load": "node scripts/seed-load-test.mjs",
    "test:load": "node scripts/run-load-test.mjs",
    "test:load:unit": "vitest run scripts/load-test-common.test.mjs",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "npm run lint:code && npm run lint:styles && npm run lint:hardcodes && npm run typecheck",
    "lint:code": "eslint .",
    "lint:styles": "stylelint src/style.css",
    "lint:hardcodes": "node scripts/check-hardcodes.mjs",
    "lint:migrations": "node scripts/check-migrations.mjs",
    "check:icons": "node scripts/check-app-icons.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run lint && npm run lint:migrations && npm run check:icons && npm test && npm run build && npm run check:bundle"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "dependencies": {
    "@material-symbols/svg-400": "0.47.0",
    "@supabase/supabase-js": "^2.115.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "pg-query-emscripten": "^5.1.0",
    "postcss": "^8.5.28",
    "stylelint": "^17.14.1",
    "supabase": "2.116.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
