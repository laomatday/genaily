# Supabase browser client. The publishable key is intentionally safe for a
# public client; database access is constrained by grants and RLS policies.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Public, versioned brand asset in Supabase Storage. The app falls back to the
# bundled copy when Supabase is unavailable, including during offline startup.
VITE_BRAND_ASSET_BUCKET="brand-assets"
VITE_BRAND_LOGO_PATH="logos/genaily-mark-v1.png"

# Optional client limits. Defaults live in src/config/appConfig.ts.
VITE_SESSION_PAGE_SIZE="20"
VITE_EXCEPTION_PAGE_SIZE="20"
VITE_DEVICE_COMMAND_PAGE_SIZE="12"
VITE_DEVICE_DELIVERY_PAGE_SIZE="60"
VITE_DEVICE_ONLINE_WINDOW_SECONDS="180"
VITE_NOTIFICATION_PAGE_SIZE="30"
VITE_MILESTONE_PAGE_SIZE="12"
VITE_DEFAULT_REWARD_POINTS="500"
VITE_OCCURRENCE_HORIZON_DAYS="8"
VITE_OCCURRENCE_QUERY_LIMIT="800"
VITE_REALTIME_DEBOUNCE_MS="180"
VITE_DEVICE_CLAIM_LEASE_MS="120000"
VITE_EVIDENCE_MAX_BYTES="10485760"
VITE_EVIDENCE_SIGNED_URL_SECONDS="300"
VITE_CHILD_AVATAR_MAX_BYTES="3145728"
VITE_CHILD_AVATAR_SIGNED_URL_SECONDS="3600"
VITE_CONTEXT_TTL_HOURS="168"

# Server-only Supabase Edge Function secrets. Configure with
# `supabase secrets set`; never expose these with a VITE_ prefix.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.7-flash"
# Optional companion fail-safe; defaults to 180 seconds.
DEVICE_HEARTBEAT_TIMEOUT_SECONDS="180"
# Optional external MDM webhook. Android/iOS companion apps do not require it.
DEVICE_CONTROL_WEBHOOK_URL="https://your-mdm-provider.example/commands"
DEVICE_CONTROL_WEBHOOK_TOKEN="YOUR_PROVIDER_TOKEN"

# Authenticated E2E (use isolated local/staging credentials only).
# E2E_SUPABASE_URL="http://127.0.0.1:54321"
# E2E_SUPABASE_PUBLISHABLE_KEY="YOUR_LOCAL_ANON_KEY"
# E2E_SUPABASE_SERVICE_ROLE_KEY="YOUR_LOCAL_SERVICE_ROLE_KEY"
# E2E_PARENT_EMAIL="parent-e2e@example.test"
# E2E_PARENT_PASSWORD="USE_A_TEST_ONLY_PASSWORD"
# E2E_CHILD_NAME="Bé kiểm thử"
# E2E_SECOND_CHILD_NAME="Bé kiểm thử 2"
# E2E_ALLOW_DATA_MUTATION="true"
